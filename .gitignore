# ==========================================
# DATASETS
# ==========================================

# Raw datasets - not uploaded to GitHub
data/raw/*
!data/raw/.gitkeep

# Staging datasets - not uploaded to GitHub
data/staging/*
!data/staging/.gitkeep

# Processed datasets - tracked by Git
# Final datasets - tracked by Git
# Add specific ignore rules if datasets become too large.

# ==========================================
# DATABASE
# ==========================================

# Local database staging files
database/staging/*
!database/staging/.gitkeep

# Generated analytical outputs
database/analytical_mart/*
!database/analytical_mart/.gitkeep

# Database backups - do not upload to GitHub
database/backup/*
!database/backup/.gitkeep

# Local database files
*.db
*.sqlite
*.sqlite3
*.backup
*.dump

# ==========================================
# PYTHON
# ==========================================

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# ==========================================
# NOTEBOOKS
# ==========================================

.ipynb_checkpoints/
*.ipynb_checkpoints

# ==========================================
# ENVIRONMENT & SECRETS
# ==========================================

.env
.env.*
!.env.example

# ==========================================
# IDE & EDITOR
# ==========================================

.vscode/
.idea/
*.code-workspace

# ==========================================
# OPERATING SYSTEM
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================

*.log
*.tmp
*.bak
*.swp

# ==========================================
# DASHBOARD EXPORTS
# ==========================================

dashboard/exports/*
!dashboard/exports/.gitkeep